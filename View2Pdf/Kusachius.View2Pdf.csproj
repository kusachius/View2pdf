<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ReleaseVersion>1.10</ReleaseVersion>
    <PackageId>Kusachius.View2Pdf</PackageId>
    <PackageVersion>$(ReleaseVersion).0</PackageVersion>
    <Authors>Aldis Arust</Authors>
    <Description>Razor view rendering and HTML-to-PDF conversion services for ASP.NET Core applications.</Description>
    <PackageTags>ASP.NET Core;Razor;HTML;PDF;view rendering</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>
</Project>
